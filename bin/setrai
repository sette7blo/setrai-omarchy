#!/usr/bin/env bash
# CLI wrapper for the Setrai Omarchy plugin.
# Called by the Omarchy menu, the .desktop launcher, and interactively.

set -euo pipefail

CONNECTION_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/setrai/credentials.json"

# The plugin's Settings view writes the server address and API key to
# CONNECTION_FILE. SETRAI_URL and SETRAI_API_KEY in the environment override it.
connection_field() {
  local field="$1"
  [[ -r "$CONNECTION_FILE" ]] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg f "$field" '.[$f] // empty' "$CONNECTION_FILE" 2>/dev/null || true
  else
    sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$CONNECTION_FILE" | head -n 1
  fi
}

SETRAI_URL="${SETRAI_URL:-$(connection_field baseUrl)}"
SETRAI_URL="${SETRAI_URL:-http://localhost:3000}"
SETRAI_URL="${SETRAI_URL%/}"
SETRAI_API_KEY="${SETRAI_API_KEY:-$(connection_field apiKey)}"

api() {
  local method="$1" path="$2" data="${3:-}"
  local -a args=(-fsS -X "$method")
  if [[ -n "$SETRAI_API_KEY" ]]; then
    args+=(-H "Authorization: Bearer $SETRAI_API_KEY")
  fi
  if [[ -n "$data" ]]; then
    args+=(-H 'Content-Type: application/json' -d "$data")
  fi
  curl "${args[@]}" "$SETRAI_URL$path"
}

cmd_open() {
  xdg-open "$SETRAI_URL${1:-/}" >/dev/null 2>&1 &
  disown
}

cmd_quick() {
  local payload="${1:-{\}}"
  local response
  response="$(api POST /api/quick-workout "$payload")"
  # Server returns { workout: {...} }; pass back into /start to persist.
  local started
  started="$(api POST /api/quick-workout/start "$response")"
  cmd_open "/"
  printf '%s\n' "$started"
}

# Reports to the terminal when there is one, otherwise as a desktop
# notification: the Omarchy menu runs these commands with no terminal.
report() {
  if [[ -t 1 ]]; then
    printf '%s\n' "$1"
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a Setrai "Setrai" "$1" || true
  fi
}

# The unit weights are typed and shown in: the profile's weightUnit.
profile_unit() {
  local profile
  profile="$(api GET /api/profile 2>/dev/null || true)"
  if [[ "$profile" =~ \"weightUnit\"[[:space:]]*:[[:space:]]*\"lb\" ]]; then
    echo lb
  else
    echo kg
  fi
}

cmd_body() {
  local weight="${1:-}" unit
  unit="$(profile_unit)"
  if [[ -z "$weight" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "Body weight ($unit): " weight || true
    elif command -v omarchy-menu-input >/dev/null 2>&1; then
      weight="$(omarchy-menu-input "Body weight ($unit)" || true)"
    fi
  fi
  weight="${weight//[[:space:]]/}"
  weight="${weight/,/.}"
  [[ -n "$weight" ]] || return 0
  # A trailing kg or lb overrides the profile's unit for this entry.
  case "${weight,,}" in
    *kg) unit=kg; weight="${weight%??}" ;;
    *lb) unit=lb; weight="${weight%??}" ;;
  esac
  if ! [[ "$weight" =~ ^[0-9]+(\.[0-9]+)?$ ]] || [[ "$weight" =~ ^0*(\.0*)?$ ]]; then
    report "Not a valid body weight: $weight"
    return 2
  fi
  local kg="$weight"
  if [[ "$unit" == lb ]]; then
    kg="$(awk -v w="$weight" 'BEGIN { printf "%.2f", w / 2.2046226218 }')"
  fi
  local today error
  today="$(date +%Y-%m-%d)"
  if error="$(api POST /api/body-weight "{\"weightKg\":$kg,\"date\":\"$today\"}" 2>&1 >/dev/null)"; then
    report "Logged $weight $unit for $today"
  else
    report "Could not log body weight. ${error:-Is Setrai running?}"
    return 1
  fi
}

cmd_stats()    { cmd_open "/statistics"; }
cmd_recovery() { cmd_open "/recovery"; }

usage() {
  cat <<EOF
Usage: setrai <command> [args]

Commands:
  open [path]        Open Setrai PWA in default browser (optional path, e.g. /statistics)
  quick [json]       Generate + start a quick workout, then open it
  body [weight]      Log body weight for today in your profile's unit (asks if omitted)
  stats              Open the Statistics page
  recovery           Open the Recovery page

Connection:
  $CONNECTION_FILE
  (server address and API key, written by the plugin's Settings view;
  SETRAI_URL and SETRAI_API_KEY in the environment override it)
EOF
}

case "${1:-}" in
  open)     shift; cmd_open "$@" ;;
  quick)    shift; cmd_quick "$@" ;;
  body)     shift; cmd_body "$@" ;;
  stats)    cmd_stats ;;
  recovery) cmd_recovery ;;
  ""|-h|--help) usage ;;
  *)        usage; exit 2 ;;
esac
