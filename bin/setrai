#!/usr/bin/env bash
# CLI wrapper for the Setrai Omarchy plugin.
# Called by the Omarchy menu, the .desktop launcher, and interactively.

set -euo pipefail

CONNECTION_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/setrai/credentials.json"

# The plugin's Settings view writes the server address and API key to
# CONNECTION_FILE. SETRAI_URL and SETRAI_API_KEY in the environment override it.
connection_field() {
  local field="$1"
  [[ -r "$CONNECTION_FILE" ]] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg f "$field" '.[$f] // empty' "$CONNECTION_FILE" 2>/dev/null || true
  else
    sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$CONNECTION_FILE" | head -n 1
  fi
}

SETRAI_URL="${SETRAI_URL:-$(connection_field baseUrl)}"
SETRAI_URL="${SETRAI_URL:-http://localhost:3000}"
SETRAI_URL="${SETRAI_URL%/}"
SETRAI_API_KEY="${SETRAI_API_KEY:-$(connection_field apiKey)}"

api() {
  local method="$1" path="$2" data="${3:-}"
  local -a args=(-fsS -X "$method")
  if [[ -n "$SETRAI_API_KEY" ]]; then
    args+=(-H "Authorization: Bearer $SETRAI_API_KEY")
  fi
  if [[ -n "$data" ]]; then
    args+=(-H 'Content-Type: application/json' -d "$data")
  fi
  curl "${args[@]}" "$SETRAI_URL$path"
}

# Opens Setrai in its own window where Omarchy can, otherwise in the browser.
cmd_open() {
  local url="$SETRAI_URL${1:-/}"
  if command -v omarchy-launch-webapp >/dev/null 2>&1; then
    omarchy-launch-webapp "$url" >/dev/null 2>&1 &
  else
    xdg-open "$url" >/dev/null 2>&1 &
  fi
  disown
}

cmd_quick() {
  local payload="${1:-{\}}"
  local response
  response="$(api POST /api/quick-workout "$payload")"
  # Server returns { workout: {...} }; pass back into /start to persist.
  local started
  started="$(api POST /api/quick-workout/start "$response")"
  local id=""
  if command -v jq >/dev/null 2>&1; then
    id="$(jq -r '.session.id // empty' <<<"$started" 2>/dev/null || true)"
  fi
  if [[ -n "$id" ]]; then cmd_open "/sessions/$id"; else cmd_open "/"; fi
  printf '%s\n' "$started"
}

# Reports to the terminal when there is one, otherwise as a desktop
# notification: the Omarchy menu runs these commands with no terminal.
report() {
  if [[ -t 1 ]]; then
    printf '%s\n' "$1"
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a Setrai "Setrai" "$1" || true
  fi
}

# Asks which of the given names to use: a numbered list in a terminal, the
# Omarchy menu picker otherwise. Prints the chosen name, or nothing.
pick() {
  local prompt="$1"; shift
  if [[ -t 0 && -t 1 ]]; then
    local i=1 name answer
    for name in "$@"; do printf '%2d) %s\n' "$i" "$name" >&2; i=$((i + 1)); done
    read -r -p "$prompt (number): " answer || true
    if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= $# )); then
      printf '%s\n' "${!answer}"
    fi
  elif command -v omarchy-menu-select >/dev/null 2>&1; then
    omarchy-menu-select "$prompt" "$@" || true
  fi
}

# Starts a session from a saved program and opens it. Setrai itself allows a
# second open session, so an open one is resumed instead of starting another.
cmd_start() {
  if ! command -v jq >/dev/null 2>&1; then
    report "setrai start needs jq."
    return 1
  fi
  local sessions open
  if ! sessions="$(api GET /api/sessions 2>/dev/null)"; then
    report "Setrai is not responding. Check that the server is running."
    return 1
  fi
  open="$(jq -r '[.sessions[] | select(.finishedAt == null)][0].id // empty' <<<"$sessions")"
  if [[ -n "$open" ]]; then
    report "A workout is already in progress. Opening it instead."
    cmd_open "/sessions/$open"
    return 0
  fi

  local id="${1:-}"
  if [[ -z "$id" ]]; then
    local programs
    programs="$(api GET /api/programs)"
    # One line per program: "<id><TAB><name>". A name used twice gets its id
    # appended so the choice maps back to one program.
    local -a ids=() names=()
    local pid pname
    while IFS=$'\t' read -r pid pname; do
      [[ -n "$pid" ]] || continue
      ids+=("$pid"); names+=("$pname")
    done < <(jq -r '
      .programs
      | (map(.name) | group_by(.) | map(select(length > 1) | .[0])) as $dup
      | .[]
      | [(.id | tostring), (if (.name | IN($dup[])) then "\(.name) #\(.id)" else .name end)]
      | @tsv' <<<"$programs")
    if (( ${#ids[@]} == 0 )); then
      report "No saved programs. Create one in Setrai first."
      return 1
    fi
    local choice i
    choice="$(pick "Start workout" "${names[@]}")"
    [[ -n "$choice" ]] || return 0
    for i in "${!names[@]}"; do
      if [[ "${names[$i]}" == "$choice" ]]; then id="${ids[$i]}"; break; fi
    done
    [[ -n "$id" ]] || return 0
  fi
  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    report "Not a program id: $id"
    return 2
  fi

  local started session
  if ! started="$(api POST /api/sessions "{\"programId\":$id}" 2>/dev/null)"; then
    report "Could not start the workout. The program may no longer exist."
    return 1
  fi
  session="$(jq -r '.session.id // empty' <<<"$started")"
  if [[ -z "$session" ]]; then
    report "Setrai did not return a session."
    return 1
  fi
  report "Started $(jq -r '.session.programName // "workout"' <<<"$started")"
  cmd_open "/sessions/$session"
}

# The unit weights are typed and shown in: the profile's weightUnit.
profile_unit() {
  local profile
  profile="$(api GET /api/profile 2>/dev/null || true)"
  if [[ "$profile" =~ \"weightUnit\"[[:space:]]*:[[:space:]]*\"lb\" ]]; then
    echo lb
  else
    echo kg
  fi
}

cmd_body() {
  local weight="${1:-}" unit
  unit="$(profile_unit)"
  if [[ -z "$weight" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "Body weight ($unit): " weight || true
    elif command -v omarchy-menu-input >/dev/null 2>&1; then
      weight="$(omarchy-menu-input "Body weight ($unit)" || true)"
    fi
  fi
  weight="${weight//[[:space:]]/}"
  weight="${weight/,/.}"
  [[ -n "$weight" ]] || return 0
  # A trailing kg or lb overrides the profile's unit for this entry.
  case "${weight,,}" in
    *kg) unit=kg; weight="${weight%??}" ;;
    *lb) unit=lb; weight="${weight%??}" ;;
  esac
  if ! [[ "$weight" =~ ^[0-9]+(\.[0-9]+)?$ ]] || [[ "$weight" =~ ^0*(\.0*)?$ ]]; then
    report "Not a valid body weight: $weight"
    return 2
  fi
  local kg="$weight"
  if [[ "$unit" == lb ]]; then
    kg="$(awk -v w="$weight" 'BEGIN { printf "%.2f", w / 2.2046226218 }')"
  fi
  local today error
  today="$(date +%Y-%m-%d)"
  if error="$(api POST /api/body-weight "{\"weightKg\":$kg,\"date\":\"$today\"}" 2>&1 >/dev/null)"; then
    report "Logged $weight $unit for $today"
  else
    report "Could not log body weight. ${error:-Is Setrai running?}"
    return 1
  fi
}

cmd_stats()    { cmd_open "/statistics"; }
cmd_recovery() { cmd_open "/recovery"; }

usage() {
  cat <<EOF
Usage: setrai <command> [args]

Commands:
  open [path]        Open Setrai in its own window (optional path, e.g. /statistics)
  start [programId]  Start a workout from a saved program (asks which if omitted)
  quick [json]       Generate + start a quick workout, then open it
  body [weight]      Log body weight for today in your profile's unit (asks if omitted)
  stats              Open the Statistics page
  recovery           Open the Recovery page

Connection:
  $CONNECTION_FILE
  (server address and API key, written by the plugin's Settings view;
  SETRAI_URL and SETRAI_API_KEY in the environment override it)
EOF
}

case "${1:-}" in
  open)     shift; cmd_open "$@" ;;
  start)    shift; cmd_start "$@" ;;
  quick)    shift; cmd_quick "$@" ;;
  body)     shift; cmd_body "$@" ;;
  stats)    cmd_stats ;;
  recovery) cmd_recovery ;;
  ""|-h|--help) usage ;;
  *)        usage; exit 2 ;;
esac
