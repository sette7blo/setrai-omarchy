// Omarchy menu extension for Setrai.
// install.sh merges these entries into ~/.config/omarchy/extensions/omarchy-menu.jsonc,
// the one user menu file Omarchy reads. Keep one entry per line.
// Icons are Nerd Font (Material Design) glyphs.
{
  "fitness": { "icon": "󰓅", "label": "Fitness" },
  "fitness.setrai": { "icon": "󰏌", "label": "Open Setrai", "action": "setrai open" },
  "fitness.start": { "icon": "󰐊", "label": "Start workout", "action": "setrai start" },
  "fitness.quick": { "icon": "󰑮", "label": "Quick workout", "action": "setrai quick" },
  "fitness.body": { "icon": "󰑴", "label": "Log body weight", "action": "setrai body" },
  "fitness.coach": { "icon": "󰚩", "label": "Ask coach", "description": "Review your training with your default agent", "when": "[[ -n \"$(omarchy-default-agent 2>/dev/null)\" ]]", "action": "setrai coach" },
  "fitness.stats": { "icon": "󰄪", "label": "Show stats", "action": "setrai stats" }
}
